import de.visualdigits.common.domain.util.EncryptedString;
import de.visualdigits.newshomereader.domain.model.applicationjson.AppJson;
import de.visualdigits.newshomereader.domain.model.unified.MediaItem;
import de.visualdigits.newshomereader.domain.model.unified.NewsFeedItem;
import kotlin.Boolean;
import kotlin.String;
import kotlin.collections.List;

--
-- SETTINGS
--
CREATE TABLE SettingsEntity (
    id INTEGER NOT NULL DEFAULT 0,
    backgroundColor TEXT NOT NULL DEFAULT "00ffffff",
    buttonColor TEXT NOT NULL DEFAULT "00888888",
    textColor TEXT NOT NULL DEFAULT "00000000",
    spotColor TEXT NOT NULL DEFAULT "00cdb2de",
    clockColor TEXT NOT NULL DEFAULT "0159ffff",
    language TEXT NOT NULL,
    refreshInterval TEXT NOT NULL,
    refreshWifiOnly INTEGER AS Boolean NOT NULL DEFAULT 0,
    lastMaxImageSize INTEGER NOT NULL,
    keepReadArticles TEXT NOT NULL,
    keepUnreadArticles TEXT NOT NULL,
    loadArticles INTEGER AS Boolean NOT NULL DEFAULT 0,
    prefetchImages INTEGER AS Boolean NOT NULL DEFAULT 0,
    hideRead INTEGER AS Boolean NOT NULL DEFAULT 0,
    webDavUrl TEXT NOT NULL DEFAULT "",
    webDavDirectory TEXT NOT NULL DEFAULT "",
    webDavUser TEXT NOT NULL DEFAULT "",
    webDavPassword TEXT AS EncryptedString NOT NULL DEFAULT ""
);

insertSettings:
INSERT INTO SettingsEntity (
    backgroundColor, buttonColor, textColor, spotColor, clockColor, language, refreshInterval, refreshWifiOnly, lastMaxImageSize, keepReadArticles,
    keepUnreadArticles, loadArticles, prefetchImages, hideRead, webDavUrl, webDavDirectory, webDavUser, webDavPassword
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getSettingsById:
SELECT * FROM SettingsEntity WHERE id = :id;

updateSettingsEntity:
UPDATE SettingsEntity
SET backgroundColor = :backgroundColor,
    buttonColor = :buttonColor,
    textColor = :textColor,
    spotColor = :spotColor,
    clockColor = :clockColor,
    language = :language,
    refreshInterval = :refreshInterval,
    refreshWifiOnly = :refreshWifiOnly,
    lastMaxImageSize = :lastMaxImageSize,
    keepReadArticles = :keepReadArticles,
    keepUnreadArticles = :keepUnreadArticles,
    loadArticles = :loadArticles,
    prefetchImages = :prefetchImages,
    hideRead = :hideRead,
    webDavUrl = :webDavUrl,
    webDavDirectory = :webDavDirectory,
    webDavUser = :webDavUser,
    webDavPassword = :webDavPassword
WHERE id IS :id;

deleteSettings:
DELETE FROM SettingsEntity
WHERE id IS :id;

--
-- NEWS FEED
--
CREATE TABLE NewsFeedEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    identifier TEXT NOT NULL,
    feedName TEXT NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    link TEXT NOT NULL,
    image TEXT NOT NULL,
    imageTitle TEXT NOT NULL,
    imageCaption TEXT NOT NULL,
    updatedMillis INTEGER NOT NULL,
    updatedZone TEXT NOT NULL,
    rights TEXT NOT NULL,
    language TEXT NOT NULL,
    keywords TEXT AS List<String> NOT NULL
);

CREATE INDEX IF NOT EXISTS index_news_feed_feedname ON NewsFeedEntity(feedName);

insertNewsFeed:
INSERT INTO NewsFeedEntity (
    identifier, feedName, title, description, link, image,
    imageTitle, imageCaption, updatedMillis, updatedZone,
    rights, language, keywords
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllNewsFeeds:
SELECT * FROM NewsFeedEntity;

getNewsFeedById:
SELECT * FROM NewsFeedEntity WHERE id = :id;

getNewsFeedByFeedName:
SELECT * FROM NewsFeedEntity WHERE LOWER(feedName) = LOWER(:feedName);

updateNewsFeed:
UPDATE NewsFeedEntity
SET title = :title,
    identifier = :identifier,
    description = :description,
    link = :link,
    image = :image,
    imageTitle = :imageTitle,
    imageCaption = :imageCaption,
    updatedMillis = :updatedMillis,
    updatedZone = :updatedZone,
    rights = :rights,
    language = :language,
    keywords = :keywords
WHERE feedName = :feedName;

deleteNewsFeedByFeedName:
DELETE FROM NewsFeedEntity
WHERE identifier == :identifier;

--
-- NEWS ITEM
--
CREATE TABLE NewsItemEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    feedName  TEXT NOT NULL,
    identifier  TEXT NOT NULL,
    publishedMillis  INTEGER NOT NULL,
    publishedZone TEXT NOT NULL,
    updatedMillis INTEGER NOT NULL,
    lastSeenMillis INTEGER NOT NULL,
    updatedZone  TEXT NOT NULL,
    link  TEXT NOT NULL,
    title  TEXT NOT NULL,
    summary  TEXT NOT NULL,
    content  TEXT NOT NULL,
    keywords  TEXT NOT NULL,
    image  TEXT NOT NULL,
    imageTitle  TEXT NOT NULL,
    imageCaption  TEXT NOT NULL,
    isRead INTEGER AS Boolean NOT NULL DEFAULT 0,
    UNIQUE(feedName, identifier)
);

CREATE INDEX IF NOT EXISTS index_news_item_feedname ON NewsItemEntity(feedName);
CREATE INDEX IF NOT EXISTS index_news_item_updated ON NewsItemEntity(updatedMillis);

insertNewsItem:
INSERT INTO NewsItemEntity (
    feedName, identifier, publishedMillis, publishedZone,
    updatedMillis, lastSeenMillis, updatedZone, link, title, summary,
    content, keywords, image, imageTitle, imageCaption, isRead
)
VALUES (
    ?, ?, ?, ?,
    ?, ?, ?, ?, ?, ?,
    ?, ?, ?, ?, ?, ?
);

updateNewsItem:
UPDATE NewsItemEntity
SET feedName = :feedName,
    identifier = :identifier,
    publishedMillis = :publishedMillis,
    publishedZone = :publishedZone,
    updatedMillis = :updatedMillis,
    lastSeenMillis = :lastSeenMillis,
    updatedZone = :updatedZone,
    link = :link,
    title = :title,
    summary = :summary,
    content = :content,
    keywords = :keywords,
    image = :image,
    imageTitle = :imageTitle,
    imageCaption = :imageCaption,
    isRead = :isRead
WHERE id = :id;

getAllNewsItems:
SELECT * FROM NewsItemEntity;

getNewsItemById:
SELECT * FROM NewsItemEntity WHERE id = :id;

getNewsItemByFeedNameAndIdentifier:
SELECT * FROM NewsItemEntity WHERE feedName = :feedName AND identifier = :identifier;

getAllNewsItemsByFeedName:
SELECT * FROM NewsItemEntity WHERE feedName = :feedName
ORDER BY updatedMillis DESC;

markNewsItemsAsReadById:
UPDATE NewsItemEntity
SET isRead = :isRead
WHERE id IN :idList;

markNewsItemsAsReadByFeedNameAndIdentifier:
UPDATE NewsItemEntity
SET isRead = 1
WHERE feedName == :feedName AND identifier == :identifier;

getReadNewsItems:
SELECT * FROM NewsItemEntity
WHERE isRead = 1;

deleteNewsItemsByFeedName:
DELETE FROM NewsItemEntity
WHERE feedName == :feedName;

cleanupOldReadNewsItems:
DELETE FROM NewsItemEntity
WHERE lastSeenMillis < :timeStamp AND isRead = 1;

cleanupOldUnreadNewsItems:
DELETE FROM NewsItemEntity
WHERE lastSeenMillis < :timeStamp AND isRead = 0;

--
-- FULL ARTICLE
--
CREATE TABLE FullArticleEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    itemId INTEGER NOT NULL UNIQUE,
    applicationJson TEXT AS List<AppJson> NOT NULL,
    html TEXT NOT NULL,
    imageItems TEXT AS List<MediaItem> NOT NULL,
    videoItems TEXT AS List<MediaItem> NOT NULL,
    audioItems TEXT AS List<MediaItem> NOT NULL,
    articleImage TEXT,
    discussionUrl TEXT,
    commentCount INTEGER NOT NULL,
    isPaid INTEGER AS Boolean NOT NULL DEFAULT 1,
    wordCount INTEGER NOT NULL,
    readingTime INTEGER NOT NULL,
    FOREIGN KEY(itemId) REFERENCES NewsItemEntity(id) ON DELETE CASCADE
);

insertFullArticle:
INSERT INTO FullArticleEntity (
    itemId, applicationJson, html, imageItems, videoItems,
    audioItems, articleImage, discussionUrl, commentCount, isPaid, wordCount, readingTime
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateFullArticle:
UPDATE FullArticleEntity
SET id = :id,
    applicationJson = :applicationJson,
    html = :html,
    imageItems = :imageItems,
    videoItems = :videoItems,
    audioItems = :audioItems,
    articleImage = :articleImage,
    discussionUrl = :discussionUrl,
    commentCount = :commentCount,
    isPaid = :isPaid,
    wordCount = :wordCount,
    readingTime = :readingTime
WHERE itemId = :itemId;

getFullArticleById:
SELECT * FROM FullArticleEntity WHERE id = :id;

getFullArticleByItemId:
SELECT * FROM FullArticleEntity WHERE itemId = :itemId;

getAllNewsItemsWithArticles:
SELECT NewsItemEntity.*, FullArticleEntity.*
FROM NewsItemEntity
LEFT JOIN FullArticleEntity ON NewsItemEntity.id = FullArticleEntity.itemId;

searchNewsItems:
SELECT NewsItemEntity.*, FullArticleEntity.*
FROM NewsItemEntity
LEFT JOIN FullArticleEntity ON NewsItemEntity.id = FullArticleEntity.itemId
WHERE LOWER(NewsItemEntity.title) LIKE LOWER('%' || :query || '%')
   OR LOWER(NewsItemEntity.summary) LIKE LOWER('%' || :query || '%')
   OR LOWER(NewsItemEntity.keywords) LIKE LOWER('%' || :query || '%')
   OR LOWER(FullArticleEntity.html) LIKE LOWER('%' || :query || '%')
ORDER BY NewsItemEntity.publishedMillis DESC;

--
-- NEWS FEED CONFIGURATION
--

CREATE TABLE NewsFeedGroupEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    parentId INTEGER,
    parentGroupName TEXT,
    name TEXT NOT NULL UNIQUE,
    type TEXT NOT NULL,
    newsFeeds TEXT AS List<NewsFeedItem> NOT NULL,
    FOREIGN KEY(parentId) REFERENCES NewsFeedGroupEntity(id) ON DELETE CASCADE
);

insertNewsFeedGroupEntity:
INSERT INTO NewsFeedGroupEntity (
    parentId, parentGroupName, name, type, newsFeeds
)
VALUES (?, ?, ?, ?, ?);

updateNewsFeedGroupEntity:
UPDATE NewsFeedGroupEntity
SET parentId = :parentId,
    parentGroupName = :parentGroupName,
    name = :name,
    type = :type,
    newsFeeds = :newsFeeds
WHERE id = :id;

getAllNewsFeedGroupEntities:
SELECT * FROM NewsFeedGroupEntity;

getNewsFeedGroupEntityById:
SELECT * FROM NewsFeedGroupEntity
WHERE id = :id;

getNewsFeedGroupEntityByName:
SELECT * FROM NewsFeedGroupEntity
WHERE name = :name AND parentGroupName = :parentGroupName;

getNewsFeedGroupEntitiesByParentName:
SELECT * FROM NewsFeedGroupEntity
WHERE parentGroupName = :parentGroupName;

deleteNewsFeedGroupEntity:
DELETE FROM NewsFeedGroupEntity
WHERE id = :id;

deleteAllNewsFeedGroupEntities:
DELETE FROM NewsFeedGroupEntity;

deleteNewsFeedGroupEntityByName:
DELETE FROM NewsFeedGroupEntity
WHERE name = :name;
