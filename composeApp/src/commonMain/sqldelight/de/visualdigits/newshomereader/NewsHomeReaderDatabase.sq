import de.visualdigits.newshomereader.domain.model.applicationjson.AppJson;
import de.visualdigits.newshomereader.domain.model.unified.MediaItem;
import de.visualdigits.newshomereader.domain.model.unified.NewsFeedItem;
import kotlin.Boolean;
import kotlin.String;
import kotlin.collections.List;


--
-- SETTINGS
--
CREATE TABLE SettingsEntity (
    id INTEGER NOT NULL DEFAULT 0,
    displayTheme TEXT NOT NULL,
    language TEXT NOT NULL,
    refreshInterval TEXT NOT NULL,
    refreshWifiOnly INTEGER AS Boolean NOT NULL DEFAULT 0,
    lastMaxImageSize INTEGER NOT NULL,
    keepReadArticles TEXT NOT NULL DEFAULT 0,
    keepUnreadArticles TEXT NOT NULL DEFAULT 0,
    loadArticles INTEGER AS Boolean NOT NULL DEFAULT 0,
    hideRead INTEGER AS Boolean NOT NULL DEFAULT 0
);

insertSettings:
INSERT OR REPLACE INTO SettingsEntity (
    displayTheme, language, refreshInterval, refreshWifiOnly, lastMaxImageSize, keepReadArticles,
    keepUnreadArticles, loadArticles, hideRead
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

getSettingsById:
SELECT * FROM SettingsEntity WHERE id = :id;

getAllSettings:
SELECT * FROM SettingsEntity;

deleteSettings:
DELETE FROM SettingsEntity
WHERE id IS :id;

--
-- NEWS FEED
--
CREATE TABLE NewsFeedEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    identifier TEXT NOT NULL,
    feedName TEXT NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    link TEXT NOT NULL,
    image TEXT NOT NULL,
    imageTitle TEXT NOT NULL,
    imageCaption TEXT NOT NULL,
    updatedMillis INTEGER NOT NULL,
    updatedZone TEXT NOT NULL,
    rights TEXT NOT NULL,
    language TEXT NOT NULL,
    keywords TEXT AS List<String> NOT NULL
);

CREATE INDEX IF NOT EXISTS index_news_feed_feedname ON NewsFeedEntity(feedName);

insertNewsFeed:
INSERT OR REPLACE INTO NewsFeedEntity (
    identifier, feedName, title, description, link, image,
    imageTitle, imageCaption, updatedMillis, updatedZone,
    rights, language, keywords
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllNewsFeeds:
SELECT * FROM NewsFeedEntity;

getNewsFeedById:
SELECT * FROM NewsFeedEntity WHERE id = :id;

getNewsFeedByFeedName:
SELECT * FROM NewsFeedEntity WHERE feedName = :feedName;



--
-- NEWS ITEM
--
CREATE TABLE NewsItemEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    feedName  TEXT NOT NULL,
    identifier  TEXT NOT NULL,
    publishedMillis  INTEGER NOT NULL,
    publishedZone TEXT NOT NULL,
    updatedMillis INTEGER NOT NULL,
    lastSeenMillis INTEGER NOT NULL,
    updatedZone  TEXT NOT NULL,
    link  TEXT NOT NULL,
    title  TEXT NOT NULL,
    summary  TEXT NOT NULL,
    content  TEXT NOT NULL,
    keywords  TEXT NOT NULL,
    image  TEXT NOT NULL,
    imageTitle  TEXT NOT NULL,
    imageCaption  TEXT NOT NULL,
    isRead INTEGER AS Boolean NOT NULL DEFAULT 0,
    UNIQUE(feedName, identifier)
);

CREATE INDEX IF NOT EXISTS index_news_item_feedname ON NewsItemEntity(feedName);
CREATE INDEX IF NOT EXISTS index_news_item_updated ON NewsItemEntity(updatedMillis);

insertNewsItem:
INSERT OR REPLACE INTO NewsItemEntity (
    feedName, identifier, publishedMillis, publishedZone,
    updatedMillis, lastSeenMillis, updatedZone, link, title, summary,
    content, keywords, image, imageTitle, imageCaption, isRead
)
VALUES (
    :feedName, :identifier, :publishedMillis, :publishedZone,
    :updatedMillis, :lastSeenMillis, :updatedZone, :link, :title, :summary,
    :content, :keywords, :image, :imageTitle, :imageCaption, :isRead
);

getAllNewsItems:
SELECT * FROM NewsItemEntity;

getNewsItemById:
SELECT * FROM NewsItemEntity WHERE id = :id;

getNewsItemByFeedNameAndIdentifier:
SELECT * FROM NewsItemEntity WHERE feedName = :feedName AND identifier = :identifier;

getAllNewsItemsByFeedName:
SELECT * FROM NewsItemEntity WHERE feedName = :feedName
ORDER BY updatedMillis DESC;

markNewsItemsAsRead:
UPDATE NewsItemEntity
SET isRead = :isRead
WHERE id IN :idList;

cleanupOldReadNewsItems:
DELETE FROM NewsItemEntity
WHERE lastSeenMillis < :timeStamp AND isRead = 1;

cleanupOldUnreadNewsItems:
DELETE FROM NewsItemEntity
WHERE lastSeenMillis < :timeStamp AND isRead = 0;


--
-- FULL ARTICLE
--
CREATE TABLE FullArticleEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    itemId INTEGER NOT NULL UNIQUE,
    applicationJson TEXT AS List<AppJson> NOT NULL,
    html TEXT NOT NULL,
    imageItems TEXT AS List<MediaItem> NOT NULL,
    videoItems TEXT AS List<MediaItem> NOT NULL,
    audioItems TEXT AS List<MediaItem> NOT NULL,
    articleImage TEXT,
    discussionUrl TEXT,
    commentCount INTEGER NOT NULL,
    isFree INTEGER AS Boolean NOT NULL DEFAULT 1,
    wordCount INTEGER NOT NULL,
    readingTime INTEGER NOT NULL,
    FOREIGN KEY(itemId) REFERENCES NewsItemEntity(id) ON DELETE CASCADE
);

insertFullArticle:
INSERT OR REPLACE INTO FullArticleEntity (
    itemId, applicationJson, html, imageItems, videoItems,
    audioItems, articleImage, discussionUrl, commentCount, isFree, wordCount, readingTime
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getFullArticleById:
SELECT * FROM FullArticleEntity WHERE id = :id;

getFullArticleByItemId:
SELECT * FROM FullArticleEntity WHERE itemId = :itemId;



--
-- NEWS FEED CONFIGURATION
--

CREATE TABLE NewsFeedGroupEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    parentId INTEGER,
    parentGroupName TEXT,
    name TEXT NOT NULL UNIQUE,
    newsFeeds TEXT AS List<NewsFeedItem> NOT NULL,
    subGroups TEXT AS List<NewsFeedGroupEntity> NOT NULL,
    FOREIGN KEY(parentId) REFERENCES NewsFeedGroupEntity(id) ON DELETE CASCADE
);

insertNewsFeedGroupEntity:
INSERT OR REPLACE INTO NewsFeedGroupEntity (
    parentGroupName, name, newsFeeds, subGroups
)
VALUES (?, ?, ?, ?);

getAllNewsFeedGroupEntities:
SELECT * FROM NewsFeedGroupEntity;

getNewsFeedGroupEntityById:
SELECT * FROM NewsFeedGroupEntity
WHERE id = :id;

getNewsFeedGroupEntityByName:
SELECT * FROM NewsFeedGroupEntity
WHERE name = :name;

deleteNewsFeedGroupEntity:
DELETE FROM NewsFeedGroupEntity
WHERE id = :id;

deleteNewsFeedGroupEntityByName:
DELETE FROM NewsFeedGroupEntity
WHERE name = :name;
